<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Activity</title>
<style>
  :root{
    --bg: #0a0a0d;
    --surface: #14141a;
    --surface-2: #1c1c24;
    --border: #262631;
    --text: #f2f2f5;
    --text-dim: #8b8b98;
    --text-faint: #55555f;
    --green: #16c784;
    --green-bg: rgba(22,199,132,0.12);
    --red: #ea3943;
    --red-bg: rgba(234,57,67,0.12);
    --gold: #f0b90b;
  }
  *{ box-sizing: border-box; }
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans Bengali", Roboto, sans-serif;
    min-height:100vh;
  }
  .app{
    max-width:480px;
    margin:0 auto;
    min-height:100vh;
    background:var(--bg);
    display:flex;
    flex-direction:column;
  }

  /* Header */
  .header{
    display:flex;
    align-items:center;
    gap:14px;
    padding:18px 16px 14px;
    position:sticky;
    top:0;
    background:var(--bg);
    z-index:5;
  }
  .back-btn{
    width:34px; height:34px;
    border-radius:10px;
    background:var(--surface);
    border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    color:var(--text);
    cursor:pointer;
    flex-shrink:0;
  }
  .back-btn:hover{ background:var(--surface-2); }
  .header h1{
    font-size:19px;
    font-weight:600;
    margin:0;
    letter-spacing:-0.01em;
  }

  /* Tabs */
  .tabs{
    display:flex;
    gap:6px;
    padding:4px 16px 16px;
  }
  .tab{
    padding:8px 16px;
    border-radius:20px;
    font-size:13.5px;
    font-weight:500;
    border:1px solid var(--border);
    background:transparent;
    color:var(--text-dim);
    cursor:pointer;
    white-space:nowrap;
  }
  .tab.active{
    background:var(--gold);
    border-color:var(--gold);
    color:#171313;
  }

  .content{
    flex:1;
    padding:0 16px 32px;
    overflow-y:auto;
  }

  .section-label{
    font-size:13px;
    color:var(--text-dim);
    padding:18px 2px 10px;
    font-weight:500;
  }
  .section-label:first-child{ padding-top:6px; }

  .card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:14px;
    overflow:hidden;
  }

  .row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:14px 16px;
  }
  .row + .row{
    border-top:1px solid var(--border);
  }

  .row-left{
    display:flex;
    flex-direction:column;
    gap:4px;
    min-width:0;
  }
  .row-title{
    font-size:14.5px;
    font-weight:600;
    color:var(--text);
  }
  .row-sub{
    font-size:12px;
    color:var(--text-faint);
  }
  .row-sub .ref{
    color:var(--text-faint);
  }

  .row-right{
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:6px;
    flex-shrink:0;
  }

  .pill{
    font-size:13px;
    font-weight:700;
    padding:4px 10px;
    border-radius:8px;
    white-space:nowrap;
  }
  .pill.pos{ color:var(--green); background:var(--green-bg); }
  .pill.neg{ color:var(--red); background:var(--red-bg); }

  .status{
    font-size:11.5px;
    font-weight:500;
  }
  .status.completed{ color:var(--text-dim); }
  .status.success{ color:var(--green); }
  .status.pending{ color:var(--gold); }

  .amount{
    font-size:14.5px;
    font-weight:700;
  }

  .empty{
    text-align:center;
    padding:60px 20px;
    color:var(--text-faint);
    font-size:13.5px;
  }

  ::-webkit-scrollbar{ width:0; height:0; }
</style>
</head>
<body>

<div class="app">

  <div class="header">
    <button class="back-btn" aria-label="Back" onclick="window.history.back()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <h1>Activity</h1>
  </div>

  <div class="tabs">
    <button class="tab active" data-tab="all">All</button>
    <button class="tab" data-tab="trades">Trades</button>
    <button class="tab" data-tab="deposit">Deposit</button>
    <button class="tab" data-tab="withdraw">Withdraw</button>
  </div>

  <div class="content" id="content">
    <!-- content injected by JS -->
  </div>

</div>

<script>
  // ---- Dummy data (matches the reference screenshot) ----
  const trades = [
    { pair:"ETHUSDT", time:"11 Sept 2026, 01:29", ref:"O2026091101291696076", amount:-100.00, status:"Completed" },
    { pair:"ETHUSDT", time:"11 Sept 2026, 00:51", ref:"O2026091100514776074", amount:28.80,  status:"Completed" },
    { pair:"ETHUSDT", time:"11 Sept 2026, 00:50", ref:"O2026091100500534162", amount:24.00,  status:"Completed" },
    { pair:"ETHUSDT", time:"11 Sept 2026, 00:48", ref:"O2026091100482844589", amount:20.00,  status:"Completed" },
  ];

  const deposits = [
    { title:"Deposit", time:"11 Sept 2026, 00:47", ref:"DLZXXOAwqI9f8TVQLFk4", amount:100.00, status:"Success" },
  ];

  const withdrawals = [
    // empty in reference screenshot — shown as an empty state
  ];

  function fmtSigned(n){
    const sign = n >= 0 ? "+" : "-";
    return `${sign}${Math.abs(n).toFixed(2)} USDT`;
  }

  function tradeRow(t){
    const positive = t.amount >= 0;
    return `
      <div class="row">
        <div class="row-left">
          <div class="row-title">${t.pair}</div>
          <div class="row-sub">${t.time}</div>
          <div class="row-sub ref">Ref: ${t.ref}</div>
        </div>
        <div class="row-right">
          <span class="pill ${positive ? "pos" : "neg"}">${fmtSigned(t.amount)}</span>
          <span class="status completed">${t.status}</span>
        </div>
      </div>`;
  }

  function depositRow(d){
    return `
      <div class="row">
        <div class="row-left">
          <div class="row-title">${d.title}</div>
          <div class="row-sub">${d.time}</div>
          <div class="row-sub ref">Ref: ${d.ref}</div>
        </div>
        <div class="row-right">
          <span class="amount">${d.amount.toFixed(2)} USDT</span>
          <span class="status success">${d.status}</span>
        </div>
      </div>`;
  }

  function withdrawRow(w){
    return `
      <div class="row">
        <div class="row-left">
          <div class="row-title">${w.title}</div>
          <div class="row-sub">${w.time}</div>
          <div class="row-sub ref">Ref: ${w.ref}</div>
        </div>
        <div class="row-right">
          <span class="amount">-${w.amount.toFixed(2)} USDT</span>
          <span class="status ${w.status.toLowerCase()}">${w.status}</span>
        </div>
      </div>`;
  }

  function renderSection(label, rowsHtml){
    if(!rowsHtml){
      return `<div class="section-label">${label}</div><div class="card"><div class="empty">No activity yet</div></div>`;
    }
    return `<div class="section-label">${label}</div><div class="card">${rowsHtml}</div>`;
  }

  function render(tab){
    const el = document.getElementById("content");
    let html = "";

    if(tab === "all" || tab === "trades"){
      html += renderSection("Recent Trades", trades.map(tradeRow).join(""));
    }
    if(tab === "all" || tab === "deposit"){
      html += renderSection("Deposit", deposits.map(depositRow).join(""));
    }
    if(tab === "all" || tab === "withdraw"){
      html += renderSection("Withdraw", withdrawals.map(withdrawRow).join(""));
    }

    el.innerHTML = html;
  }

  document.querySelectorAll(".tab").forEach(btn=>{
    btn.addEventListener("click", ()=>{
      document.querySelectorAll(".tab").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      render(btn.dataset.tab);
    });
  });

  render("all");
</script>

</body>
</html>
